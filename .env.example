PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Required - server refuses to boot without this
JWT_SECRET=change-this-to-a-long-random-string

# Database - leave both blank for local dev (uses a SQLite file under backend/data/).
# Set both to point the server at a hosted Turso/libSQL database instead, so data
# survives restarts on hosts with an ephemeral filesystem (e.g. Render's free tier).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Seed admin account (created by `npm run seed` if it doesn't already exist)
SEED_ADMIN_EMAIL=admin@electric.com
SEED_ADMIN_PASSWORD=Admin123!

# SMTP - optional. If SMTP_HOST is unset, order notification emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@electric-shop.example
ADMIN_NOTIFY_EMAIL=
